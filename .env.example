# 数据默认保存在项目目录下的 data/，也可以使用绝对路径。
MEETOMINUTE_DATA_DIR=data
MEETOMINUTE_HOST=127.0.0.1
MEETOMINUTE_PORT=8000
MEETOMINUTE_MAX_UPLOAD_MB=4096

# 首次启动默认使用 mock，便于验证完整工作流但不会产生真实转写。
# 转写可选：mock / funasr / openai；纪要可选：mock / ollama / openai
MEETOMINUTE_LOCAL_TRANSCRIBER=mock
MEETOMINUTE_CLOUD_TRANSCRIBER=openai
MEETOMINUTE_LOCAL_LLM=mock
MEETOMINUTE_CLOUD_LLM=openai

# OpenAI 兼容接口。Ollama 可将 BASE_URL 设为 http://127.0.0.1:11434/v1。
# 也可启动应用后在“外部 LLM”设置页配置；界面配置会动态覆盖外部纪要所用的这些值。
MEETOMINUTE_OPENAI_BASE_URL=https://api.openai.com/v1
MEETOMINUTE_OPENAI_API_KEY=
MEETOMINUTE_TRANSCRIBE_MODEL=whisper-1
MEETOMINUTE_LLM_MODEL=
MEETOMINUTE_REQUEST_TIMEOUT_SECONDS=600
MEETOMINUTE_LLM_CHUNK_CHARS=6000
# 单次纪要请求的输入字符预算（系统提示、模板和待处理内容合计）。
# 不依赖特定模型 tokenizer；低于 4000 的值会按 4000 处理。
MEETOMINUTE_LLM_INPUT_CHAR_BUDGET=6000
MEETOMINUTE_LLM_MAX_TOKENS=4096
MEETOMINUTE_LLM_REASONING_EFFORT=

# Ollama 本地纪要后端。模型需先在 Ollama 中存在。
MEETOMINUTE_OLLAMA_BASE_URL=http://127.0.0.1:11435/v1
MEETOMINUTE_OLLAMA_MODEL=
MEETOMINUTE_OLLAMA_BIN=ollama
MEETOMINUTE_OLLAMA_REASONING_EFFORT=none

# FunASR 本地模型。auto 会在 CUDA 可用时使用 cuda:0，否则使用 CPU。
# 模型缓存默认位于 data/models，不写入用户目录。
MEETOMINUTE_FUNASR_MODEL=paraformer-zh
MEETOMINUTE_FUNASR_VAD_MODEL=fsmn-vad
MEETOMINUTE_FUNASR_PUNC_MODEL=ct-punc
MEETOMINUTE_FUNASR_SPK_MODEL=cam++
MEETOMINUTE_FUNASR_DEVICE=auto
MEETOMINUTE_FUNASR_BATCH_SIZE_S=120
MEETOMINUTE_FUNASR_ISOLATE_PROCESS=true
